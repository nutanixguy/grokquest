# Backend: openai (default), xai, or compatible.
# AI_PROVIDER wins over LLM_PROVIDER. --provider wins over both.
AI_PROVIDER=openai

# LLM_PROVIDER=xai

# Required when the provider is openai.
OPENAI_API_KEY=your_openai_api_key_here

# Required when the provider is xai.
XAI_API_KEY=your_xai_api_key_here

# Required when the provider is compatible.
# AI_API_KEY=your_api_key_here

# API root. Required for compatible. Optional override for openai and xai.
# Use the /v1 root, not the full chat-completions path.
# AI_BASE_URL=https://api.example.com/v1

# Model id. AI_MODEL wins over LLM_MODEL. --model wins over both.
# Defaults: gpt-4o-mini (openai), grok-4.7 (xai). Required for compatible.
# AI_MODEL=gpt-4o-mini
# LLM_MODEL=grok-4.7

# xAI reasoning effort: low (default) or medium.
# LLM_REASONING_EFFORT=low
