# LLM backend: openai (default) or xai
LLM_PROVIDER=xai

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Required when LLM_PROVIDER=xai
XAI_API_KEY=your_xai_api_key_here

# Optional model override.
# Defaults: gpt-4o-mini (openai), grok-4.7 (xai)
# LLM_MODEL=grok-4.7

# Optional xAI reasoning effort: low (default) or medium
LLM_REASONING_EFFORT=low
